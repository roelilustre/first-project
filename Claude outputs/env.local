# Supabase keys for this project
# NEVER commit this file. It is listed in .gitignore.
# Paste each value after the = sign, with no quotes and no spaces.

# ---- Safe for the browser (public) ----
# Dashboard > Project Settings > API Keys (also shown under the "Connect" button)
# Looks like: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Dashboard > Project Settings > API Keys > "Publishable key"
# Starts with: sb_publishable_
SUPABASE_PUBLISHABLE_KEY=

# ---- SERVER ONLY - keep secret, never put in index.html or front-end code ----
# Dashboard > Project Settings > API Keys > "Secret keys" (click to reveal / copy)
# Starts with: sb_secret_   (bypasses all Row Level Security)
SUPABASE_SECRET_KEY=

# ---- Optional: direct database access ----
# Dashboard > "Connect" button (top of project) > Connection string
# Replace [YOUR-PASSWORD] with the database password you set when creating the project
SUPABASE_DB_URL=
